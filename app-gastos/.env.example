# Variables de entorno públicas para la app (Expo)
# Reemplaza por la URL de tu backend (local o servidor)
# Ejemplos:
# - Android emulator: http://10.0.2.2:3000/api
# - Local (web/dev client): http://localhost:3000/api

EXPO_PUBLIC_API_BASE=http://localhost:3000/api

# Opcional: indicar plataforma en tiempo de compilación (usado en código con process.env.EXPO_OS)
# EXPO_OS=web
