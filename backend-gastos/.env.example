# CONFIGURACION DE AUTENTICACION JWT
JWT_SECRET=tu_secreto_jwt_super_seguro_cambiar_en_produccion
JWT_EXPIRATION=7d

# ORIGENES PERMITIDOS PARA CORS (separados por comas)
# Ejemplo: http://localhost:8081,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000

# CONFIGURACION DE IA (Ollama Local o Tunel Ngrok)
# Para local: http://localhost:11434
# Para remoto: https://tu-tunel.ngrok-free.app
IA_API_URL=http://localhost:11434
IA_MODEL=neural-chat

# CONFIGURACION DE BASE DE DATOS
DATABASE_TYPE=postgres
# DATABASE_PATH=./gastos.db (solo para sqlite)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gastos_db


# CONFIGURACION DE EMAILJS (API REST - opcional)
# Si prefieres usar la API REST de EmailJS desde tu backend, añade estas variables:
# CONFIGURACION DE EMAILJS (API REST)
# La aplicación usa exclusivamente EmailJS para el envío de correos.
# Añade las credenciales de EmailJS aquí:
EMAILJS_SERVICE_ID=service_xxx
EMAILJS_TEMPLATE_ID=template_xxx
EMAILJS_PUBLIC_KEY=user_xxx
# Si desde el backend necesitas usar una clave privada para la REST API, añádela aquí (opcional):
EMAILJS_ACCESS_TOKEN=private_xxx

# CONFIGURACION DE LA APLICACION
NODE_ENV=development
PORT=3000
